# Copia a .env.local y completa (no subas .env ni .env.local al repositorio)
#
# Vercel: Project Settings → Environment Variables (Production + Preview)
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_YOUTUBE_API_KEY (opcional)
# Play Store (TWA/Capacitor): mismas variables en el build nativo.

# Supabase — Settings → API (Project URL + anon public key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias legacy (opcional si ya usabas este nombre):
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional
# VITE_SUPABASE_PROJECT_ID=

# SEO (Vercel → Environment Variables → Production + Preview)
# REQUIRED for song URLs in sitemap / Googlebot prerender:
#   SUPABASE_SERVICE_ROLE_KEY   Supabase → Settings → API → service_role (secret, server only)
# Optional:
#   SUPABASE_URL=               same as VITE_SUPABASE_URL
#   SITE_URL=https://worshiptranspose.com
# After deploy check: https://worshiptranspose.com/api/seo-status
# Also apply: supabase/migrations/20260806190000_seo_song_catalog.sql
# Then Google Search Console → add sitemap https://worshiptranspose.com/sitemap.xml

# SEO (Vercel server only — never expose service_role to the browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SITE_URL=https://worshiptranspose.com

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YOUTUBE_API_KEY=

# Opcional: piped | mock (mock solo en desarrollo)
# VITE_YOUTUBE_SEARCH_MODE=
# VITE_PIPED_API_BASE=https://pipedapi.kavin.rocks

# Diagnóstico YouTube (0–3; omitir o 99 = normal) — src/features/youtube-search/ytDiagnostic.ts
# VITE_YT_DIAG_STAGE=

# Diagnóstico árbol React (0–6; omitir o 99 = normal) — src/renderDiag.ts
# VITE_RENDER_DIAG_STAGE=

# Smoke test post-deploy: añadir ?debug=1 a la URL (ver docs/SMOKE_TEST.md)
